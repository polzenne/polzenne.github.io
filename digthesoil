<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>スコアランキング（ページャ＆検索・並べ替え機能）</title>
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <!-- DataTables -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
</head>
<body>
<div class="container mt-5">
  <h2>スコアランキング</h2>
  <div id="table-area"></div>
</div>

<script>
const url = "https://script.google.com/macros/s/AKfycbxhXlJD-Tjo3PsQr2CWb1MZsT8T5EO8j2f-mOxM_BHgZ_whkHjIXTt1tuUI1IcW5Vpi/exec";

fetch(url)
  .then(res => res.text())
  .then(data => {
    // データ変換
    const rows = data.split('%0A')
      .map(row => row.split('%2C').map(col => decodeURIComponent(col)))
      .filter(cols => cols.length === 4 && Number(cols[1]) > 0); // スコア0除く

    // スコア降順ソート
    rows.sort((a, b) => Number(b[1]) - Number(a[1]));

    // テーブルHTML生成
    let table = `
      <table id="scoreTable" class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>順位</th>
            <th>名前</th>
            <th>スコア</th>
            <th>日付</th>
          </tr>
        </thead><tbody>
    `;
    rows.forEach((cols, idx) => {
      table += `<tr>
        <td>${idx + 1}</td>
        <td>${cols[0]}</td>
        <td>${cols[1]}</td>
        <td>${cols[2]}</td>
      </tr>`;
    });
    table += '</tbody></table>';
    $("#table-area").html(table);

    // DataTable初期化
    $("#scoreTable").DataTable({
      language: {
        url: "https://cdn.datatables.net/plug-ins/1.13.7/i18n/ja.json" // 日本語化
      },
      pageLength: 100,
      lengthMenu: [5, 10, 20, 50, 100]
    });
  });
</script>

</body>
</html>
